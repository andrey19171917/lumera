# ============================================================
#  ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ LUMERA
#  Скопируйте значения в настройки проекта на Vercel:
#  Project → Settings → Environment Variables
#  (этот файл — только образец, реальные ключи сюда не коммитьте)
# ============================================================

# --- Telegram (обязательно для уведомлений в Telegram) ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID чата, КУДА приходят заявки (ваш личный chat_id или id группы)
TELEGRAM_CHAT_ID=123456789

# --- Почта через Resend (для писем владельцу и каталога клиенту) ---
# API-ключ из https://resend.com (Dashboard → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# От кого уходят письма. Домен должен быть подтверждён в Resend.
# Пример: LUMERA <info@vash-domen.ru>
MAIL_FROM=LUMERA <info@vash-domen.ru>
# Куда дублировать заявки (ваша почта)
MAIL_TO=vasha-pochta@gmail.com

# --- Каталог ---
# Прямая ссылка на PDF-каталог (после деплоя он лежит в корне сайта)
CATALOG_URL=https://vash-sait.vercel.app/catalog.pdf
# Прикреплять PDF файлом к письму клиенту? true / false
# (false = в письме будет только кнопка скачивания — рекомендуется)
CATALOG_ATTACH=false

# --- Прочее ---
BRAND_NAME=LUMERA
